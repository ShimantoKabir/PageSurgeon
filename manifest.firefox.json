{
  "manifest_version": 3,
  "name": "PageSurgeon",
  "version": "0.0.1",
  "description": "Inject custom JavaScript and CSS into web pages. Compatible with Chrome and Firefox.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/shared.js", "src/background.js"]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "PageSurgeon"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "page-surgeon@local.extension",
      "strict_min_version": "136.0"
    }
  }
}
